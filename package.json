{
  "name": "book-ui",
  "version": "1.0.0",
  "private": true,
  "description": "读书笔记",
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "build:h5": "uni build --mode production && node scripts/offline-shell.mjs",
    "build:h5:stage": "uni build --mode staging --outDir dist/staging/h5 && node scripts/offline-shell.mjs dist/staging/h5",
    "deploy:h5": "npm run build:h5 && wrangler deploy --config wrangler.jsonc",
    "build:app": "uni build -p app --mode production",
    "build:app:stage": "uni build -p app --mode staging --outDir dist/staging/app",
    "type-check": "vue-tsc --noEmit",
    "build:wgt": "npm run build:app && node scripts/release-wgt.mjs",
    "publish:wgt": "npm run build:app && node scripts/release-wgt.mjs --publish"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "pinia": "2.2.4",
    "vue": "3.4.21",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "adm-zip": "0.5.16",
    "sass": "^1.104.1",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  },
  "//vue": "vue 与 @vue/* 必须与 @dcloudio/* 锁定的 3.4.21 完全一致，不能写 ^，否则运行时会因运行时与编译器版本不一致报错",
  "//uni-app-plus": "别删。@dcloudio/uni-app 会 import 官方 vue 从未导出过的 isInSSRComponentSetup，缺失时 App 端构建失败",
  "//pinia": "2.2.6+ 的 peer 要求 vue ^3.5.11，与锁定的 3.4.21 冲突，因此钉 2.2.4"
}
